{
  "name": "prestige-tours",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/gen-image-manifest.mjs && vite",
    "build": "node scripts/gen-image-manifest.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir .ssr-build && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:client": "node scripts/gen-image-manifest.mjs && vite build",
    "images": "python3 scripts/gen_images.py",
    "serve": "node scripts/serve-dist.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0"
  }
}
